{
  // 焰境·万载 — Workers Static Assets（方案 §4 / §9）
  // 注意：whizzzest.com zone 归属 nathanpenny@qq.com 账号，部署前 wrangler 需登录该账号。
  "name": "whizzzest",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 只有需要 Worker 逻辑的路径先过 Worker（访客采集的文档路径 / API / 商户动态页 / R2 图片代理），
    // 其余静态资产（图片/CSS/JS）直达边缘，省一次 Worker 调用
    "run_worker_first": [
      "/api/*",
      "/assets-merchant/*",
      "/merchants",
      "/merchants/*",
      "/",
      "/about",
      "/about/*",
      "/cuisine",
      "/cuisine/*",
      "/heritage",
      "/heritage/*",
      "/industry",
      "/industry/*",
      "/spots",
      "/spots/*",
      "/tourism",
      "/tourism/*",
      "/pay",
      "/pay/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whizzzest",
      "database_id": "cdfc8884-e978-4a10-b45b-a3babdd9ae46"
    }
  ],
  // 商户图片桶（merchant Worker 上传，本 Worker /assets-merchant/* 代理公开读取）
  "r2_buckets": [
    {
      "binding": "IMG",
      "bucket_name": "whizzzest-merchant"
    }
  ],
  "routes": [
    { "pattern": "whizzzest.com", "custom_domain": true },
    { "pattern": "www.whizzzest.com", "custom_domain": true }
  ]
}
