{
  // 焰境·万载 — 管理后台 Worker（admin.whizzzest.com，整域即后台）
  // 与公开站（根目录 whizzzest）分离部署：后台挂了不影响主站。
  // 线上凭据用 wrangler secret 配置：ADMIN_PASSWORD / ADMIN_SESSION_SECRET
  "name": "whizzzest-admin",
  "compatibility_date": "2026-09-01",
  "main": "index.js",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whizzzest",
      "database_id": "cdfc8884-e978-4a10-b45b-a3babdd9ae46"
    }
  ],
  // 商户图片桶（删除商户时级联清理 m<id>/ 前缀对象；与 merchant/ 根 worker 同桶）
  // 万载TV 媒体桶（视频/封面直传，tv/ 前缀；主站经 /media/* 代理公开读取，docs/万载TV方案.md）
  "r2_buckets": [
    {
      "binding": "IMG",
      "bucket_name": "whizzzest-merchant"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "whizzzest-media"
    }
  ],
  "routes": [
    { "pattern": "admin.whizzzest.com", "custom_domain": true }
  ]
}
